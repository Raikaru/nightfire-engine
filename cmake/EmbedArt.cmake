# Embeds the generated UI art sheets (assets/ui/<sheet>.png + <sheet>.txt, see tools/art/) into a C++ source.
# Run as a script: cmake -DART_DIR=<dir> -DOUT=<file.cpp> -P EmbedArt.cmake
file(GLOB sheets RELATIVE "${ART_DIR}" "${ART_DIR}/*.png")
list(SORT sheets)
set(body "// Generated by cmake/EmbedArt.cmake from assets/ui; do not edit.\n#include \"ui/art_sheet_data.hpp\"\n\nnamespace nf::ui::art_data {\nnamespace {\n")
set(table "")
set(index 0)
foreach(png IN LISTS sheets)
  string(REGEX REPLACE "\\.png$" "" name "${png}")
  file(READ "${ART_DIR}/${png}" hex HEX)
  string(LENGTH "${hex}" hex_len)
  math(EXPR size "${hex_len} / 2")
  string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
  string(REGEX REPLACE "((0x[0-9a-f][0-9a-f],){24})" "\\1\n" bytes "${bytes}")
  file(READ "${ART_DIR}/${name}.txt" manifest)
  string(REPLACE "\\" "\\\\" manifest "${manifest}")
  string(REPLACE "\"" "\\\"" manifest "${manifest}")
  string(REPLACE "\n" "\\n\"\n\"" manifest "${manifest}")
  string(APPEND body "const unsigned char kPng${index}[] = {\n${bytes}\n};\nconst char kManifest${index}[] = \"${manifest}\";\n")
  string(APPEND table "    {\"${name}\", kPng${index}, ${size}, kManifest${index}},\n")
  math(EXPR index "${index} + 1")
endforeach()
string(APPEND body "}  // namespace\n\nconst Sheet kSheets[] = {\n${table}};\nconst std::size_t kSheetCount = ${index};\n\n}  // namespace nf::ui::art_data\n")
file(WRITE "${OUT}.tmp" "${body}")
file(COPY_FILE "${OUT}.tmp" "${OUT}" ONLY_IF_DIFFERENT)
file(REMOVE "${OUT}.tmp")
